{
  "name": "tm-builder-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run build:renderer && next build --webpack",
    "build:renderer": "esbuild src/render.ts --bundle --minify --platform=node --format=cjs --outfile=public/assets/render.cjs --legal-comments=linked",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.*"
  },
  "dependencies": {
    "@viz-js/viz": "^3.0.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
